<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .sidebar-gradient { background: linear-gradient(180deg,#0f172a 0%,#1a2332 50%,#162032 100%); }
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @keyframes fadeIn { from { opacity:0;transform:translateY(8px); } to { opacity:1;transform:translateY(0); } }
    .info-row { display:flex; justify-content:space-between; align-items:center; padding:11px 0; border-bottom:1px solid #f1f5f9; }
    .info-row:last-child { border-bottom:none; }
    .info-label { font-size:0.8rem; color:#64748b; font-weight:500; min-width:130px; }
    .info-value { font-size:0.875rem; color:#1e293b; font-weight:600; text-align:right; }
    .severity-bar { height:8px; border-radius:999px; overflow:hidden; background:#f1f5f9; }
    .severity-fill { height:100%; border-radius:999px; transition:width .4s ease; }
    /* modal */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,.6); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; }
    .modal-box { background:#fff; border-radius:16px; padding:28px; width:100%; max-width:460px; box-shadow:0 25px 60px rgba(0,0,0,.2); }
  </style>
</head>
<body class="min-h-screen bg-slate-50">
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col lg:ml-72">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-4 sm:p-6 fade-in">
      <%- include('../partials/flash') %>

      <!-- Back -->
      <a href="<%= r.deleted_at ? '/violation-reports?status_filter=deleted' : '/violation-reports' %>" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-600 mb-5 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> กลับรายการ
      </a>

      <!-- Status banner -->
      <% if (r.deleted_at) { %>
      <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 text-sm font-medium">
        <i data-lucide="archive-x" class="w-5 h-5 text-slate-500 flex-shrink-0"></i>
        รายการนี้ <strong>ถูกลบชั่วคราว</strong>
        <% if (r.deleted_by_name) { %><span class="ml-auto text-sm text-slate-500">ลบโดย <%= r.deleted_by_name %></span><% } %>
        <% if (r.delete_reason) { %><span class="text-sm text-red-500">เหตุผล: <%= r.delete_reason %></span><% } %>
      </div>
      <% } else if (r.status === 'pending') { %>
      <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-orange-50 border border-orange-200 text-orange-800 text-sm font-medium">
        <i data-lucide="clock" class="w-5 h-5 text-orange-500 flex-shrink-0"></i>
        รายการนี้ <strong>รอตรวจสอบ</strong> — ยังไม่ได้ดำเนินการยืนยันหรือปฏิเสธ
      </div>
      <% } else if (r.status === 'confirmed') { %>
      <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium">
        <i data-lucide="check-circle" class="w-5 h-5 text-green-600 flex-shrink-0"></i>
        รายการนี้ <strong>ยืนยัน</strong> แล้ว — บันทึกลงประวัติการกระทำผิดเรียบร้อย
        <% if (r.reviewed_by_name) { %><span class="ml-auto text-xs text-green-600">โดย <%= r.reviewed_by_name %></span><% } %>
      </div>
      <% } else if (r.status === 'rejected') { %>
      <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium">
        <i data-lucide="x-circle" class="w-5 h-5 text-red-500 flex-shrink-0"></i>
        รายการนี้ <strong>ถูกปฏิเสธ</strong>
        <% if (r.review_note) { %> — "<%= r.review_note %>"<% } %>
        <% if (r.reviewed_by_name) { %><span class="ml-auto text-xs text-red-500">โดย <%= r.reviewed_by_name %></span><% } %>
      </div>
      <% } %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- LEFT: main info -->
        <div class="lg:col-span-2 space-y-6">

          <!-- Report card -->
          <div class="card p-6">
            <div class="flex items-start gap-4 mb-6">
              <div style="width:50px;height:50px;background:#fff7ed;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="clipboard-check" class="w-6 h-6 text-orange-500"></i>
              </div>
              <div class="flex-1">
                <h2 class="text-xl font-bold text-slate-800">รายการแจ้งเลขที่ <%= r.report_code || ('IR-GEN-' + String(r.id).padStart(6, '0')) %></h2>
                <p class="text-sm text-slate-500 mt-0.5">
                  <%= new Date(r.reported_at).toLocaleDateString('th-TH',{year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
                </p>
              </div>
              <% if (r.status === 'pending') { %>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-700 border border-orange-200">
                <i data-lucide="clock" class="w-3 h-3"></i> รอตรวจสอบ
              </span>
              <% } %>
            </div>

            <!-- Rule violation bar -->
            <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:16px;margin-bottom:20px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <span style="font-size:0.8rem;font-weight:700;color:#991b1b;">กฎที่ฝ่าฝืน: <%= r.rule_name %></span>
                <span style="font-size:0.75rem;font-weight:700;color:<%= existingViolationCount >= r.max_violations ? '#dc2626' : '#d97706' %>;">
                  ครั้งปัจจุบัน <%= existingViolationCount %>/<%= r.max_violations %>
                </span>
              </div>
              <div class="severity-bar">
                <div class="severity-fill"
                     style="width:<%= Math.min((existingViolationCount/r.max_violations)*100,100) %>%;
                            background:<%= existingViolationCount >= r.max_violations ? '#ef4444' : '#f59e0b' %>;"></div>
              </div>
              <% if (r.rule_desc) { %>
              <p style="margin-top:10px;font-size:0.78rem;color:#7c2d12;"><%= r.rule_desc %></p>
              <% } %>
              <% if (r.penalty && existingViolationCount >= r.max_violations) { %>
              <p style="margin-top:8px;font-size:0.8rem;color:#991b1b;font-weight:600;">⚠️ บทลงโทษ: <%= r.penalty %></p>
              <% } %>
            </div>

            <!-- Description -->
            <div class="mb-5">
              <p class="info-label mb-2">รายละเอียดการกระทำผิด</p>
              <div style="background:#f8fafc;border-radius:10px;padding:14px;border:1px solid #e2e8f0;">
                <p style="font-size:0.875rem;color:#334155;line-height:1.7;"><%= r.description || 'ไม่มีรายละเอียดเพิ่มเติม' %></p>
              </div>
            </div>

            <!-- Reporter info -->
            <div style="margin-top:16px;border-top:1px solid #f1f5f9;padding-top:14px;">
              <p class="info-label" style="margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                <i data-lucide="user-check" class="w-3.5 h-3.5"></i> แจ้งโดย
              </p>
              <div style="background:#f8fafc;border-radius:10px;padding:12px 14px;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:7px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <i data-lucide="user" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                  <span style="font-size:0.875rem;font-weight:600;color:#1e293b;"><%= r.reported_by_name %></span>
                </div>
                <% if (r.reported_by_email) { %>
                <div style="display:flex;align-items:center;gap:8px;">
                  <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                  <a href="mailto:<%= r.reported_by_email %>" style="font-size:0.8rem;color:#3b82f6;text-decoration:none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'"><%= r.reported_by_email %></a>
                </div>
                <% } %>
                <% if (r.reported_by_phone) { %>
                <div style="display:flex;align-items:center;gap:8px;">
                  <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                  <a href="tel:<%= r.reported_by_phone %>" style="font-size:0.8rem;color:#1e293b;text-decoration:none;"><%= r.reported_by_phone %></a>
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Evidence photo -->
          <div class="card p-6">
            <h3 style="font-size:0.9rem;font-weight:700;color:#1e293b;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="camera" class="w-4 h-4 text-brand-500"></i> หลักฐาน (ภาพถ่าย)
            </h3>
            <% if (r.evidence_photo) { %>
              <img src="<%= signedUrl(r.evidence_photo) %>" alt="Evidence"
                   data-lightbox-src="<%= signedUrl(r.evidence_photo) %>"
                   data-lightbox-caption="รูปหลักฐาน"
                   style="max-width:100%;max-height:400px;object-fit:contain;border-radius:12px;border:1px solid #e2e8f0;cursor:pointer;transition:transform .2s;"
                   onmouseover="this.style.transform='scale(1.01)'" onmouseout="this.style.transform='scale(1)'">
              <p style="font-size:0.75rem;color:#94a3b8;margin-top:8px;">คลิกที่ภาพเพื่อขยาย</p>
            <% } else { %>
              <div style="text-align:center;padding:40px 20px;background:#f8fafc;border-radius:12px;border:1px dashed #e2e8f0;">
                <i data-lucide="image-off" class="w-10 h-10" style="display:block;margin:0 auto 8px;color:#cbd5e1;"></i>
                <p style="color:#94a3b8;font-size:0.875rem;">ไม่มีภาพหลักฐาน</p>
              </div>
            <% } %>
          </div>

        </div>

        <!-- RIGHT: actions + person info -->
        <div class="space-y-6">

          <!-- Actions card -->
          <% if (!r.deleted_at && ['pending', 'confirmed', 'rejected'].includes(r.status)) { %>
          <div data-action-group="process" class="card p-5">
              <h3 style="font-size:0.85rem;font-weight:700;color:#1e293b;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                <i data-lucide="clipboard-check" class="w-4 h-4 text-green-600"></i> ดำเนินการ
              </h3>

              <!-- CONFIRM -->
              <% if (r.status === 'pending' || r.status === 'rejected') { %>
              <form method="POST" action="/violation-reports/<%= r.id %>/confirm" onsubmit="return confirm('ยืนยันการกระทำผิดและบันทึกลงประวัติ?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" id="btn-confirm-<%= r.id %>" class="btn w-full justify-center mb-2"
                        style="background:#16a34a;color:#fff;font-size:0.85rem;gap:6px;">
                  <i data-lucide="check-circle" class="w-4 h-4"></i> ยืนยัน
                </button>
              </form>
              <% } else { %>
              <button type="button" class="btn w-full justify-center mb-2"
                      style="background:#dcfce7;color:#15803d;font-size:0.85rem;gap:6px;cursor:default;" disabled>
                <i data-lucide="check-circle" class="w-4 h-4"></i> ยืนยันแล้ว
              </button>
              <% } %>

              <!-- REJECT -->
              <button type="button" id="btn-reject-<%= r.id %>"
                      class="btn w-full justify-center"
                      style="background:<%= r.status === 'rejected' ? '#fee2e2' : '#dc2626' %>;color:<%= r.status === 'rejected' ? '#b91c1c' : '#fff' %>;font-size:0.85rem;gap:6px;<%= r.status === 'rejected' ? 'cursor:default;' : '' %>"
                      <%= r.status === 'rejected' ? 'disabled' : '' %>>
                <i data-lucide="x-circle" class="w-4 h-4"></i> <%= r.status === 'rejected' ? 'ปฏิเสธแล้ว' : 'ปฏิเสธ' %>
              </button>
          </div>

          <div data-action-group="manage" class="card p-5">
              <h3 style="font-size:0.85rem;font-weight:700;color:#1e293b;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                <i data-lucide="settings" class="w-4 h-4 text-slate-500"></i> จัดการ
              </h3>

              <button type="button" id="btn-edit-<%= r.id %>"
                      class="btn btn-secondary w-full justify-center mb-2" style="font-size:0.85rem;gap:6px;">
                <i data-lucide="pencil" class="w-4 h-4"></i> แก้ไขรายการ
              </button>

              <form method="POST"
                    action="/violation-reports/<%= r.id %>/delete"
                    data-delete-confirm
                    data-delete-reason-required="true"
                    data-delete-reason-placeholder="ระบุเหตุผลในการลบรายการ"
                    data-delete-item="รายการแจ้ง <%= r.report_code || ('IR-GEN-' + String(r.id).padStart(6, '0')) %>: <%= r.rule_name %>"
                    data-delete-detail="<%= r.first_name %> <%= r.last_name %> · <%= new Date(r.reported_at).toLocaleDateString('th-TH') %>"
                    data-delete-warning="เมื่อลบแล้ว รายการนี้จะหายจากหน้าตรวจสอบการกระทำผิดกฎ และข้อมูลที่เกี่ยวข้องจะถูกลบชั่วคราว"
                    data-delete-confirm-text="ลบรายการ">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-secondary w-full justify-center text-red-500 hover:bg-red-50" style="font-size:0.85rem;gap:6px;">
                  <i data-lucide="trash-2" class="w-4 h-4"></i> ลบรายการ
                </button>
              </form>
          </div>
          <% } %>

          <!-- Person info -->
          <div class="card p-5">
            <h3 style="font-size:0.9rem;font-weight:700;color:#1e293b;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="user" class="w-4 h-4 text-brand-500"></i> ข้อมูลผู้ลงทะเบียน
            </h3>
            <div class="info-row">
              <span class="info-label">รหัสประจำตัว</span>
              <span class="info-value" style="font-size:0.8rem;"><%= r.id_number %></span>
            </div>
            <div class="info-row">
              <span class="info-label">ชื่อ-นามสกุล</span>
              <span class="info-value"><%= r.first_name %> <%= r.last_name %></span>
            </div>
            <div class="info-row">
              <span class="info-label">ประเภท</span>
              <span class="info-value">
                <% if (r.user_type === 'student') { %>
                  <span class="badge badge-info">นักศึกษา</span>
                <% } else { %>
                  <span class="badge" style="background:#f3e8ff;color:#7c3aed;">บุคลากร</span>
                <% } %>
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">ป้ายทะเบียน</span>
              <span class="info-value" style="font-size:1rem;"><%= r.license_plate %></span>
            </div>
            <% if (r.province) { %>
            <div class="info-row">
              <span class="info-label">จังหวัด</span>
              <span class="info-value"><%= r.province %></span>
            </div>
            <% } %>
            <% if (r.phone) { %>
            <div class="info-row">
              <span class="info-label">เบอร์โทร</span>
              <span class="info-value"><%= r.phone %></span>
            </div>
            <% } %>
            <a href="/registrations/<%= r.registration_id %>"
               class="btn btn-secondary w-full justify-center mt-4" style="font-size:0.8rem;">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i> ดูข้อมูลผู้ลงทะเบียน
            </a>
          </div>

          <!-- Vehicle photos -->
          <% if (r.motorcycle_photo || r.plate_photo) { %>
          <div class="card p-5">
            <h3 style="font-size:0.9rem;font-weight:700;color:#1e293b;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
              <i data-lucide="bike" class="w-4 h-4 text-brand-500"></i> รูปภาพรถ
            </h3>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <% if (r.motorcycle_photo) { %>
              <div>
                <p style="font-size:0.7rem;color:#94a3b8;margin-bottom:4px;text-transform:uppercase;font-weight:600;letter-spacing:.03em;">รูปรถ</p>
                <img src="<%= signedUrl(r.motorcycle_photo) %>" alt="Motorcycle"
                     data-lightbox-src="<%= signedUrl(r.motorcycle_photo) %>"
                     data-lightbox-caption="รูปรถ"
                     style="width:100%;height:120px;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0;cursor:pointer;transition:transform .2s;"
                     onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
              </div>
              <% } %>
              <% if (r.plate_photo) { %>
              <div>
                <p style="font-size:0.7rem;color:#94a3b8;margin-bottom:4px;text-transform:uppercase;font-weight:600;letter-spacing:.03em;">ป้ายทะเบียน</p>
                <img src="<%= signedUrl(r.plate_photo) %>" alt="Plate"
                     data-lightbox-src="<%= signedUrl(r.plate_photo) %>"
                     data-lightbox-caption="รูปป้ายทะเบียน"
                     style="width:100%;height:120px;object-fit:cover;border-radius:10px;border:1px solid #e2e8f0;cursor:pointer;transition:transform .2s;"
                     onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
              </div>
              <% } %>
            </div>
          </div>
          <% } %>

        </div>
      </div>

      <!-- Lightbox -->
      <% if (r.evidence_photo || r.motorcycle_photo || r.plate_photo) { %>
      <div id="lightbox"
           style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.85);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(4px);padding:24px;"
           role="dialog" aria-modal="true" aria-label="Image preview">
        <button type="button" id="lightbox-close"
                style="position:absolute;top:18px;right:18px;width:40px;height:40px;border-radius:999px;border:none;background:rgba(255,255,255,.16);color:white;display:flex;align-items:center;justify-content:center;cursor:pointer;">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
        <img id="lightbox-img" alt=""
             style="max-width:90vw;max-height:84vh;object-fit:contain;border-radius:12px;box-shadow:0 25px 50px rgba(0,0,0,.3);">
        <div id="lightbox-caption"
             style="position:absolute;left:50%;bottom:22px;transform:translateX(-50%);color:white;background:rgba(15,23,42,.72);padding:6px 14px;border-radius:999px;font-size:13px;"></div>
      </div>
      <% } %>

    </main>
  </div>
</div>

<!-- ── EDIT MODAL ────────────────────────────────── -->
<div id="edit-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
        <i data-lucide="pencil" class="w-4 h-4 text-brand-500"></i> แก้ไขรายการ
      </h3>
      <button id="btn-close-edit"
              class="text-slate-400 hover:text-slate-700 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form id="edit-form" method="POST" action="/violation-reports/<%= r.id %>/edit" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="label">กฎที่ฝ่าฝืน <span class="text-red-500">*</span></label>
        <select id="edit-rule-id" name="rule_id" class="input" required>
          <option value="<%= r.rule_id %>" selected><%= r.rule_name %></option>
        </select>
        <p class="text-xs text-slate-400 mt-1">หากต้องการเปลี่ยนกฎ ให้เลือกจากรายการ (โหลดเมื่อเปิด)</p>
      </div>
      <div>
        <label class="label">รายละเอียด <span class="text-red-500">*</span></label>
        <textarea id="edit-description" name="description" rows="4" class="input" style="resize:vertical;" required
                  placeholder="รายละเอียดการกระทำผิด..."><%= r.description || '' %></textarea>
      </div>
      <div class="flex gap-3 justify-end pt-2">
        <button type="button" id="btn-cancel-edit" class="btn btn-secondary">ยกเลิก</button>
        <button id="edit-submit-button" type="submit" class="btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          <i data-lucide="save" class="w-4 h-4"></i> บันทึก
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── REJECT MODAL ──────────────────────────────── -->
<div id="reject-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="flex items-center justify-between mb-5">
        <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
          <i data-lucide="x-circle" class="w-4 h-4 text-red-500"></i> ปฏิเสธการกระทำผิดกฏ
      </h3>
      <button id="btn-close-reject"
              class="text-slate-400 hover:text-slate-700 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <p class="text-sm text-slate-600 mb-4">กรุณาระบุเหตุผลในการปฏิเสธรายการนี้</p>
    <form id="reject-form" method="POST" action="/violation-reports/<%= r.id %>/reject" class="space-y-4" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="label">เหตุผล <span class="text-red-500">*</span></label>
        <textarea id="reject-review-note" name="review_note" rows="3" class="input" style="resize:vertical;"
                  placeholder="เช่น ข้อมูลไม่ถูกต้อง, ไม่มีหลักฐานเพียงพอ..." required></textarea>
        <p id="reject-review-note-error" style="display:none; font-size:14px; color:#dc2626; margin:6px 0 0;">
          กรุณากรอกหมายเหตุก่อนยืนยัน
        </p>
      </div>
      <div class="flex gap-3 justify-end pt-2">
        <button type="button" id="btn-cancel-reject" class="btn btn-secondary">ยกเลิก</button>
        <button type="submit" class="btn" style="background:#dc2626;color:#fff;">
          <i data-lucide="x-circle" class="w-4 h-4"></i> ยืนยันการปฏิเสธ
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  lucide.createIcons();

  // ── Modal helpers ───────────────────────────────────────────────
  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'flex';
  }
  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  }
  function closeLightbox() {
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    if (lightbox) lightbox.style.display = 'none';
    if (lightboxImg) lightboxImg.removeAttribute('src');
  }

  // Close modal when clicking the backdrop (outside modal-box)
  ['edit-modal', 'reject-modal'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('click', function(e) {
      if (e.target === el) closeModal(id);
    });
  });

  // Escape key closes any open modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeModal('edit-modal');
      closeModal('reject-modal');
      closeLightbox();
    }
  });

  // ── Edit button ─────────────────────────────────────────────────
  var btnEdit = document.getElementById('btn-edit-<%= r.id %>');
  var editForm = document.getElementById('edit-form');
  var editRuleSelect = document.getElementById('edit-rule-id');
  var editDescription = document.getElementById('edit-description');
  var editSubmitButton = document.getElementById('edit-submit-button');

  function updateEditSubmitState() {
    if (!editSubmitButton || !editRuleSelect || !editDescription) return;
    editSubmitButton.disabled = !(editRuleSelect.value && editDescription.value.trim());
  }

  if (btnEdit) {
    btnEdit.addEventListener('click', function(e) {
      e.stopPropagation();
      openModal('edit-modal');
      // Load rules into select if not yet loaded
      var sel = editRuleSelect;
      if (sel && sel.options.length <= 1) {
        fetch('/rules?format=json')
          .then(function(res) { return res.ok ? res.json() : []; })
          .then(function(rules) {
            if (!rules.length) return;
            sel.innerHTML = '';
            rules.forEach(function(rule) {
              var opt = document.createElement('option');
              opt.value = rule.id;
              opt.textContent = rule.rule_name;
              if (rule.id === <%= r.rule_id %>) opt.selected = true;
              sel.appendChild(opt);
            });
            updateEditSubmitState();
          })
          .catch(function() { /* keep current option */ });
      }
      updateEditSubmitState();
    });
  }

  if (editRuleSelect) {
    editRuleSelect.addEventListener('change', updateEditSubmitState);
    editRuleSelect.addEventListener('input', updateEditSubmitState);
  }

  if (editDescription) {
    editDescription.addEventListener('input', updateEditSubmitState);
  }

  if (editForm) {
    editForm.addEventListener('submit', function(e) {
      updateEditSubmitState();
      if (editSubmitButton && editSubmitButton.disabled) {
        e.preventDefault();
        if (editForm.reportValidity) editForm.reportValidity();
        if (editRuleSelect && !editRuleSelect.value) {
          editRuleSelect.focus();
        } else if (editDescription) {
          editDescription.focus();
        }
      }
    });
  }

  // ── Reject button ────────────────────────────────────────────────
  var btnReject = document.getElementById('btn-reject-<%= r.id %>');
  var rejectForm = document.getElementById('reject-form');
  var rejectReviewNote = document.getElementById('reject-review-note');
  var rejectNoteError = document.getElementById('reject-review-note-error');

  function hideRejectNoteError() {
    if (rejectNoteError) rejectNoteError.style.display = 'none';
  }

  if (btnReject) {
    btnReject.addEventListener('click', function(e) {
      e.stopPropagation();
      hideRejectNoteError();
      openModal('reject-modal');
    });
  }

  // ── Close buttons ────────────────────────────────────────────────
  var btnCloseEdit = document.getElementById('btn-close-edit');
  if (btnCloseEdit) btnCloseEdit.addEventListener('click', function() { closeModal('edit-modal'); });

  var btnCancelEdit = document.getElementById('btn-cancel-edit');
  if (btnCancelEdit) btnCancelEdit.addEventListener('click', function() { closeModal('edit-modal'); });

  var btnCloseReject = document.getElementById('btn-close-reject');
  if (btnCloseReject) btnCloseReject.addEventListener('click', function() {
    hideRejectNoteError();
    closeModal('reject-modal');
  });

  var btnCancelReject = document.getElementById('btn-cancel-reject');
  if (btnCancelReject) btnCancelReject.addEventListener('click', function() {
    hideRejectNoteError();
    closeModal('reject-modal');
  });

  if (rejectForm && rejectReviewNote && rejectNoteError) {
    rejectForm.addEventListener('submit', function(e) {
      if (!rejectReviewNote.value.trim()) {
        e.preventDefault();
        rejectNoteError.style.display = 'block';
        rejectReviewNote.focus();
      }
    });

    rejectReviewNote.addEventListener('input', function() {
      rejectNoteError.style.display = 'none';
    });
  }

  // ── Lightbox ─────────────────────────────────────────────────────
  <% if (r.evidence_photo || r.motorcycle_photo || r.plate_photo) { %>
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var lightboxCaption = document.getElementById('lightbox-caption');

  function openLightbox(trigger) {
    if (!lightbox || !lightboxImg || !trigger) return;
    lightboxImg.src = trigger.dataset.lightboxSrc || trigger.src;
    lightboxImg.alt = trigger.dataset.lightboxCaption || trigger.alt || 'Image preview';
    if (lightboxCaption) lightboxCaption.textContent = trigger.dataset.lightboxCaption || trigger.alt || '';
    lightbox.style.display = 'flex';
  }

  if (lightbox) {
    lightbox.addEventListener('click', closeLightbox);
  }
  if (lightboxImg) {
    lightboxImg.addEventListener('click', function(e) { e.stopPropagation(); });
  }
  var lightboxClose = document.getElementById('lightbox-close');
  if (lightboxClose) {
    lightboxClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeLightbox();
    });
  }
  document.querySelectorAll('[data-lightbox-src]').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      openLightbox(trigger);
    });
  });
  <% } %>
</script>
</body>
</html>
