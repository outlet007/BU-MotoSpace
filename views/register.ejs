        'pdpa.title': 'Personal Data Consent Agreement (PDPA) <span class="required-mark">*</span>',
        'pdpa.description': 'I consent to the collection, use, and disclosure of the personal data provided in this system for motorcycle registration and management, including eligibility verification and related communication. The data will be protected using appropriate security measures and will not be used for other purposes without my consent.',
