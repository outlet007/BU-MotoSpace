<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ลงทะเบียนรถจักรยานยนต์ - BU MotoSpace</title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- reCAPTCHA v3 -->
  <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>" async defer></script>
  <style>
    /* Badge reCAPTCHA ให้เล็กลง / ไม่บังเนื้อหา */
    .grecaptcha-badge { opacity: 0.6; transition: opacity 0.3s; }
    .grecaptcha-badge:hover { opacity: 1; }
  </style>

  <style>
    .register-bg {
      background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 50%, #dcfce7 100%);
      min-height: 100vh;
    }
    .glass-card {
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .fade-in { animation: fadeIn 0.5s ease-out; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
    .tab-btn { cursor: pointer; }
    .tab-btn.active { border-color: #16a34a; color: #16a34a; background: #f0fdf4; }
    .upload-zone { border: 2px dashed #cbd5e1; transition: all 0.2s; position: relative; overflow: hidden; }
    .upload-zone:hover { border-color: #22c55e; background: #f0fdf4; }
    .upload-zone.has-file { border-color: #22c55e; background: #f0fdf4; }
    .upload-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
    .preview-img { max-height: 160px; border-radius: 12px; object-fit: cover; }
    .id-card-section { display: none; }
    .id-card-section.active { display: block; }
    .required-mark { color: #dc2626; font-weight: 700; margin-left: 0.15rem; }
    .language-toggle-wrap {
      display: inline-flex;
      align-items: center;
    }
    .flag-toggle {
      position: relative;
      display: inline-flex;
      align-items: center;
      cursor: pointer;
    }
    .flag-toggle-input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
    .flag-track {
      position: relative;
      width: 4rem;
      height: 2.15rem;
      border-radius: 999px;
      background: #cbd5e1;
      padding: 0.2rem;
      transition: background 0.2s ease;
      flex-shrink: 0;
      display: block;
    }
    .flag-track::after {
      content: '';
      position: absolute;
      top: 0.2rem;
      left: 0.2rem;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 999px;
      background:
        linear-gradient(to bottom,
          #a51931 0 16%,
          #f4f5f8 16% 28%,
          #2d2a4a 28% 72%,
          #f4f5f8 72% 84%,
          #a51931 84% 100%);
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.18);
      transition: transform 0.2s ease, background 0.2s ease;
    }
    .flag-toggle-input:checked + .flag-track {
      background: #cbd5e1;
    }
    .flag-toggle-input:checked + .flag-track::after {
      transform: translateX(1.85rem);
      background:
        /* Blue canton – top-left ~40% × 46% */
        linear-gradient(to right, #3C3B6E 0% 42%, transparent 42% 100%) top left / 100% 46% no-repeat,
        /* 13 alternating red/white stripes */
        repeating-linear-gradient(
          to bottom,
          #BF0A30 0%,
          #BF0A30 7.69%,
          #fff    7.69%,
          #fff    15.38%
        );
    }
    .flag-toggle-input:focus-visible + .flag-track {
      outline: 2px solid #16a34a;
      outline-offset: 3px;
    }
    .vehicle-extra {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      margin-top: 0 !important;
      transform: translateY(-8px);
      transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.35s ease, margin-top 0.35s ease;
    }
    .vehicle-extra.active {
      max-height: 760px;
      opacity: 1;
      transform: translateY(0);
      margin-top: 1rem !important;
    }
    .toggle-input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
    .toggle-switch {
      width: 3.25rem;
      height: 1.75rem;
      border-radius: 999px;
      background: #cbd5e1;
      padding: 0.2rem;
      transition: background 0.2s ease;
      position: relative;
      flex-shrink: 0;
    }
    .toggle-switch::after {
      content: '';
      width: 1.35rem;
      height: 1.35rem;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.18);
      position: absolute;
      top: 0.2rem;
      left: 0.2rem;
      transition: transform 0.2s ease;
    }
    .toggle-input:checked + .toggle-switch { background: #16a34a; }
    .toggle-input:checked + .toggle-switch::after { transform: translateX(1.5rem); }
    .toggle-input:focus-visible + .toggle-switch {
      outline: 2px solid #16a34a;
      outline-offset: 3px;
    }
  </style>
</head>
<body class="register-bg">
  <div class="max-w-3xl mx-auto px-4 py-8 fade-in">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-start justify-between">
        <div class="flex-1"></div>
        <div class="flex flex-col items-center">
          <div class="w-16 h-16 bg-brand-500 rounded-2xl flex items-center justify-center shadow-lg shadow-brand-500/30 mb-4">
            <i data-lucide="bike" class="w-8 h-8 text-white"></i>
          </div>
          <h1 class="text-3xl font-bold text-slate-800">BU MotoSpace</h1>
          <p class="text-slate-500 mt-2" data-i18n="header.subtitle">ระบบลงทะเบียนรถจักรยานยนต์</p>
        </div>
        <div class="flex-1 flex justify-end pt-1">
          <div class="language-toggle-wrap" aria-label="เลือกภาษา">
            <label class="flag-toggle" for="language-toggle">
              <input type="checkbox" id="language-toggle" class="flag-toggle-input" aria-label="สลับภาษา ไทย/อังกฤษ">
              <span class="flag-track" aria-hidden="true"></span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Success Modal Popup ───────────────────────────────────────── -->
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div id="successModal"
         style="display:flex;position:fixed;inset:0;z-index:10000;align-items:center;justify-content:center;padding:1rem;"
         aria-modal="true" role="dialog" aria-labelledby="success-modal-title">
      <!-- Backdrop -->
      <div style="position:absolute;inset:0;background:rgba(15,23,42,.65);backdrop-filter:blur(6px);"></div>
      <!-- Card -->
      <div style="position:relative;width:100%;max-width:420px;background:#fff;border-radius:24px;box-shadow:0 30px 70px rgba(15,23,42,.25);overflow:hidden;text-align:center;padding:2.5rem 2rem 2rem;">
        <!-- Icon circle -->
        <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#16a34a,#22c55e);margin:0 auto 1.25rem;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(22,163,74,.35);animation:successPop .45s cubic-bezier(.34,1.56,.64,1) both;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:checkDraw .5s .3s ease both;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <!-- Title -->
        <h2 id="success-modal-title" style="font-size:1.3rem;font-weight:700;color:#0f172a;margin-bottom:.5rem;">ลงทะเบียนสำเร็จ!</h2>
        <!-- Message -->
        <p style="font-size:.925rem;color:#475569;line-height:1.6;margin-bottom:1.75rem;">
          <%= success[0] %>
        </p>
        <!-- Divider -->
        <div style="width:48px;height:3px;background:linear-gradient(90deg,#16a34a,#22c55e);border-radius:99px;margin:0 auto 1.75rem;"></div>
        <!-- Info box -->
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:.875rem 1rem;font-size:.825rem;color:#15803d;margin-bottom:1.75rem;display:flex;align-items:center;gap:.625rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>เจ้าหน้าที่จะตรวจสอบและแจ้งผลการอนุมัติให้ทราบในภายหลัง</span>
        </div>
        <!-- Button -->
        <button type="button" id="successModalClose"
          style="width:100%;padding:.875rem;background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;font-size:.975rem;font-weight:600;border:none;border-radius:12px;cursor:pointer;box-shadow:0 4px 14px rgba(22,163,74,.4);transition:opacity .15s,transform .15s;">
          ตกลง
        </button>
      </div>
    </div>
    <style>
      @keyframes successPop {
        from { opacity:0; transform:scale(.6); }
        to   { opacity:1; transform:scale(1); }
      }
    </style>
    <% } %>

    <!-- Error flash (keep as banner) -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <% error.forEach(msg => { %>
      <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
        <span><%= msg %></span>
      </div>
      <% }); %>
    <% } %>


    <% const duplicatePlateMessages = typeof duplicatePlatePopup !== 'undefined' && duplicatePlatePopup ? duplicatePlatePopup : []; %>
    <% if (duplicatePlateMessages.length > 0) { %>
    <div id="duplicatePlateModal"
         style="display:flex;position:fixed;inset:0;z-index:10000;align-items:center;justify-content:center;padding:1rem;"
         aria-modal="true" role="dialog" aria-labelledby="duplicate-plate-title">
      <div data-duplicate-plate-close style="position:absolute;inset:0;background:rgba(15,23,42,.68);backdrop-filter:blur(4px);"></div>
      <div style="position:relative;width:100%;max-width:460px;background:#fff;border-radius:16px;box-shadow:0 25px 60px rgba(15,23,42,.28);overflow:hidden;">
        <div style="padding:20px 24px 14px;border-bottom:1px solid #fee2e2;">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
                <i data-lucide="alert-triangle" class="w-5 h-5"></i>
              </div>
              <div>
                <h3 id="duplicate-plate-title" class="text-base font-bold text-slate-800">พบทะเบียนรถซ้ำ</h3>
                <p class="text-sm text-slate-500 mt-1">ไม่สามารถลงทะเบียนด้วยทะเบียนนี้ได้</p>
              </div>
            </div>
            <button type="button" data-duplicate-plate-close class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="ปิด">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
        <div style="padding:20px 24px;">
          <div class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700 leading-relaxed">
            <%= duplicatePlateMessages[0] %>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;padding:0 24px 22px;">
          <button type="button" data-duplicate-plate-close class="btn btn-primary justify-center">รับทราบ</button>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Main Card -->
    <div class="glass-card rounded-3xl shadow-xl shadow-slate-200/50 border border-white/60 overflow-hidden">
      <!-- Tabs -->
      <div class="flex border-b border-slate-200">
        <button type="button" class="tab-btn active flex-1 py-4 px-6 text-sm font-semibold border-b-2 border-transparent transition-all flex items-center justify-center gap-2" data-tab="student">
          <i data-lucide="graduation-cap" class="w-5 h-5"></i>
          <span data-i18n="tabs.student">นักศึกษา</span>
        </button>
        <button type="button" class="tab-btn flex-1 py-4 px-6 text-sm font-semibold border-b-2 border-transparent text-slate-500 transition-all flex items-center justify-center gap-2" data-tab="staff">
          <i data-lucide="briefcase" class="w-5 h-5"></i>
          <span data-i18n="tabs.staff">อาจารย์/บุคลากร</span>
        </button>
      </div>

      <form method="POST" action="/register" enctype="multipart/form-data" class="p-6 md:p-8 space-y-6" id="register-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="user_type" id="user_type" value="student">
        <!-- reCAPTCHA v3 token (เติมโดย JS ก่อน submit) -->
        <input type="hidden" name="recaptcha_token" id="recaptcha_token">
        <!-- Honeypot: ซ่อนจากผู้ใช้จริง — bot มักกรอก field นี้โดยอัตโนมัติ -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:0;height:0;overflow:hidden;">
          <label for="website">Website (leave blank)</label>
          <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
        </div>

        <!-- Header Notice -->
        <div class="bg-gradient-to-r from-brand-50 to-emerald-50 rounded-2xl p-5 border border-brand-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-500 rounded-xl flex items-center justify-center flex-shrink-0">
              <i data-lucide="clipboard-list" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <h3 class="font-semibold text-slate-800 text-base" data-i18n="notice.title">กรุณากรอกข้อมูลเพื่อระบบลงทะเบียนรถจักรยานยนต์</h3>
              <p class="text-xs text-slate-500 mt-0.5" data-i18n="notice.description">กรอกข้อมูลให้ครบถ้วนและถูกต้อง เพื่อการลงทะเบียนที่สมบูรณ์</p>
            </div>
          </div>
        </div>

        <!-- Form Fields -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="label" data-i18n-html="form.firstName">ชื่อ <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="user" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="text" name="first_name" id="first_name" class="input" style="padding-left:2.75rem" placeholder="กรอกชื่อ" data-i18n-placeholder="placeholder.firstName" required>
            </div>
          </div>
          <div>
            <label class="label" data-i18n-html="form.lastName">นามสกุล <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="user" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="text" name="last_name" id="last_name" class="input" style="padding-left:2.75rem" placeholder="กรอกนามสกุล" data-i18n-placeholder="placeholder.lastName" required>
            </div>
          </div>
          <div>
            <label class="label" id="id_number_label">รหัสนักศึกษา <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="hash" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="text" name="id_number" id="id_number" class="input uppercase" style="padding-left:2.75rem" placeholder="กรอกรหัส" autocomplete="off" required>
            </div>
          </div>
          <div>
            <label class="label" data-i18n-html="form.phone">เบอร์โทรศัพท์ <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="phone" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="tel" name="phone" id="phone" class="input" style="padding-left:2.75rem" placeholder="0xxxxxxxxx" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required>
            </div>
          </div>
        </div>

        <!-- ID Card Photo Upload (switches by tab) -->
        <div class="id-card-section active" id="student-card-section">
          <label class="label" data-i18n-html="form.studentCardPhoto">รูปถ่ายบัตรนักศึกษา <span class="required-mark">*</span></label>
          <div class="upload-zone rounded-xl p-5 text-center cursor-pointer block" id="student-card-zone" role="button" tabindex="0" data-file-target="student_card_input">
            <i data-lucide="id-card" class="w-8 h-8 text-slate-400 mx-auto mb-2"></i>
            <p class="text-sm text-slate-500" data-i18n="upload.studentCard">คลิกเพื่อถ่ายรูปหรือเลือกภาพบัตรนักศึกษา</p>
            <p class="text-xs text-slate-400 mt-1" data-i18n="upload.supported">รองรับไฟล์ JPG, PNG</p>
            <input type="file" name="id_card_photo" id="student_card_input" accept="image/*" class="upload-input" aria-label="เลือกรูปถ่ายบัตรนักศึกษา" data-i18n-aria-label="aria.studentCard" onchange="previewImage(this, 'student-card-preview', 'student-card-zone')" required>
            <img id="student-card-preview" class="preview-img mx-auto mt-3 hidden">
          </div>
        </div>

        <div class="id-card-section" id="staff-card-section">
          <label class="label" data-i18n-html="form.staffCardPhoto">รูปถ่ายบัตรอาจารย์/บุคลากร <span class="required-mark">*</span></label>
          <div class="upload-zone rounded-xl p-5 text-center cursor-pointer block" id="staff-card-zone" role="button" tabindex="0" data-file-target="staff_card_input">
            <i data-lucide="id-card" class="w-8 h-8 text-slate-400 mx-auto mb-2"></i>
            <p class="text-sm text-slate-500" data-i18n="upload.staffCard">คลิกเพื่อถ่ายรูปหรือเลือกภาพบัตรอาจารย์/บุคลากร</p>
            <p class="text-xs text-slate-400 mt-1" data-i18n="upload.supported">รองรับไฟล์ JPG, PNG</p>
            <input type="file" name="id_card_photo" id="staff_card_input" accept="image/*" class="upload-input" aria-label="เลือกรูปถ่ายบัตรอาจารย์หรือบุคลากร" data-i18n-aria-label="aria.staffCard" onchange="previewImage(this, 'staff-card-preview', 'staff-card-zone')">
            <img id="staff-card-preview" class="preview-img mx-auto mt-3 hidden">
          </div>
        </div>

        <!-- Vehicle 1 -->
        <div class="rounded-2xl border border-slate-200 bg-white/70 p-5 md:p-6 space-y-5">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center flex-shrink-0">
              <i data-lucide="bike" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800" data-i18n="vehicle1.title">ข้อมูลรถคันที่ 1</h3>
              <p class="text-xs text-slate-500 mt-0.5" data-i18n="vehicle1.description">กรอกข้อมูลรถจักรยานยนต์คันหลักที่ต้องการลงทะเบียน</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="label" data-i18n-html="form.plate">ป้ายทะเบียน <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="rectangle-horizontal" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <input type="text" name="license_plate" id="license_plate" class="input" style="padding-left:2.75rem" placeholder="กข1234" autocomplete="off" required>
            </div>
          </div>
          <div>
            <label class="label" data-i18n-html="form.province">จังหวัด <span class="required-mark">*</span></label>
            <div class="relative">
              <i data-lucide="map-pin" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
              <select name="province" id="province" class="input" style="padding-left:2.75rem" required>
                <option value="" data-i18n="form.selectProvince">เลือกจังหวัด</option>
                <option value="กรุงเทพมหานคร">กรุงเทพมหานคร</option>
                <option value="กระบี่">กระบี่</option>
                <option value="กาญจนบุรี">กาญจนบุรี</option>
                <option value="กาฬสินธุ์">กาฬสินธุ์</option>
                <option value="กำแพงเพชร">กำแพงเพชร</option>
                <option value="ขอนแก่น">ขอนแก่น</option>
                <option value="จันทบุรี">จันทบุรี</option>
                <option value="ฉะเชิงเทรา">ฉะเชิงเทรา</option>
                <option value="ชลบุรี">ชลบุรี</option>
                <option value="ชัยนาท">ชัยนาท</option>
                <option value="ชัยภูมิ">ชัยภูมิ</option>
                <option value="ชุมพร">ชุมพร</option>
                <option value="เชียงราย">เชียงราย</option>
                <option value="เชียงใหม่">เชียงใหม่</option>
