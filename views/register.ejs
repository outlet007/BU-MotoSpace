        'submit.default': 'Register',
        'submit.checking': 'Verifying...',
        'submit.sending': 'Submitting...',
        'recaptcha.prefix': 'This site is protected by reCAPTCHA and the Google',
        'recaptcha.privacy': 'Privacy Policy',
        'recaptcha.and': 'and',
        'recaptcha.terms': 'Terms of Service',
        'recaptcha.suffix': 'apply',
        'footer.adminLogin': 'Staff login',
        'aria.languageToggle': 'Switch language Thai / English',
        'aria.studentCard': 'Choose student ID card photo',
        'aria.staffCard': 'Choose lecturer or staff ID card photo',
