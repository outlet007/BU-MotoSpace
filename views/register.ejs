        'aria.platePhoto': 'Choose license plate photo',
        'aria.motorcyclePhoto2': 'Choose second motorcycle photo',
        'aria.platePhoto2': 'Choose second license plate photo',
      },
    };
    let currentLanguage = 'th';

    function t(key) {
      return (i18n[currentLanguage] && i18n[currentLanguage][key]) || i18n.th[key] || '';
    }

    function applyLanguage(language) {
      currentLanguage = language === 'en' ? 'en' : 'th';
      document.documentElement.lang = currentLanguage;
      document.title = t('title');
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        el.textContent = t(el.dataset.i18n);
      });
      document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
        el.innerHTML = t(el.dataset.i18nHtml);
      });
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        el.placeholder = t(el.dataset.i18nPlaceholder);
      });
      document.querySelectorAll('[data-i18n-aria-label]').forEach(function(el) {
        el.setAttribute('aria-label', t(el.dataset.i18nAriaLabel));
      });
      const languageToggle = document.getElementById('language-toggle');
      if (languageToggle) languageToggle.setAttribute('aria-label', t('aria.languageToggle'));
      if (typeof switchTab === 'function') {
        switchTab(document.getElementById('user_type').value || 'student');
      }
    }

    (function() {
      var modal = document.getElementById('duplicatePlateModal');
      if (!modal) return;
      function closeModal() {
        modal.style.display = 'none';
      }
      document.querySelectorAll('[data-duplicate-plate-close]').forEach(function(button) {
        button.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
      });
    })();

    // ─── Success Modal ────────────────────────────────────────────────────────
    (function() {
      var successModal = document.getElementById('successModal');
      var closeBtn     = document.getElementById('successModalClose');
      if (!successModal || !closeBtn) return;

      function closeSuccessModal() {
        successModal.style.transition = 'opacity .25s ease';
        successModal.style.opacity = '0';
        setTimeout(function() {
          successModal.style.display = 'none';
          // Reset form and redirect clean URL (removes flash from address bar)
          window.location.replace('/register');
        }, 260);
      }

      closeBtn.addEventListener('click', closeSuccessModal);
      closeBtn.addEventListener('mouseover',  function() { closeBtn.style.opacity = '.88'; });
      closeBtn.addEventListener('mouseout',   function() { closeBtn.style.opacity = '1'; });
      closeBtn.addEventListener('mousedown',  function() { closeBtn.style.transform = 'scale(.97)'; });
      closeBtn.addEventListener('mouseup',    function() { closeBtn.style.transform = 'scale(1)'; });

      // Also close on Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && successModal.style.display === 'flex') closeSuccessModal();
      });
    })();

    // Tab switching
    function switchTab(type) {
      document.getElementById('user_type').value = type;
      document.querySelectorAll('.tab-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.tab === type);
        if (!btn.classList.contains('active')) {
          btn.classList.add('text-slate-500');
        } else {
          btn.classList.remove('text-slate-500');
        }
      });
      document.getElementById('id_number_label').innerHTML = (type === 'student' ? t('form.studentId') : t('form.staffId')) + ' <span class="required-mark">*</span>';
      document.getElementById('id_number').placeholder = type === 'student' ? t('placeholder.studentId') : t('placeholder.staffId');
      // Toggle ID card sections
      document.getElementById('student-card-section').classList.toggle('active', type === 'student');
      document.getElementById('staff-card-section').classList.toggle('active', type === 'staff');

      // Only submit the visible ID-card input.
      document.getElementById('student_card_input').disabled = type !== 'student';
      document.getElementById('staff_card_input').disabled = type !== 'staff';
      document.getElementById('student_card_input').required = type === 'student';
      document.getElementById('staff_card_input').required = type === 'staff';
    }

    window.switchTab = switchTab;

    document.querySelectorAll('.tab-btn[data-tab]').forEach(function(button) {
      button.addEventListener('click', function() {
        switchTab(button.dataset.tab);
      });
    });

    switchTab(document.getElementById('user_type').value || 'student');

    (function() {
      const idInput = document.getElementById('id_number');
      const phoneInput = document.getElementById('phone');
      const plateInputs = [
        document.getElementById('license_plate'),
        document.getElementById('license_plate_2'),
      ].filter(Boolean);

      if (idInput) {
        idInput.addEventListener('input', function() {
          const upperValue = idInput.value.toUpperCase();
          if (idInput.value !== upperValue) idInput.value = upperValue;
        });
      }

      if (phoneInput) {
        phoneInput.addEventListener('input', function() {
          const numericValue = phoneInput.value.replace(/\D/g, '').slice(0, 10);
          if (phoneInput.value !== numericValue) phoneInput.value = numericValue;
        });
      }

      plateInputs.forEach(function(input) {
        input.addEventListener('input', function() {
          const compactValue = input.value.replace(/\s+/g, '').toUpperCase();
          if (input.value !== compactValue) input.value = compactValue;
        });
      });
    })();

    (function() {
      const sourceProvince = document.getElementById('province');
      const secondProvince = document.getElementById('province_2');
      if (sourceProvince && secondProvince) {
        secondProvince.innerHTML = sourceProvince.innerHTML;
      }

      const toggle = document.getElementById('has_second_vehicle');
      const section = document.getElementById('second-vehicle-section');
      const secondFields = Array.from(document.querySelectorAll('[data-second-vehicle]'));
      const requiredIds = new Set(['license_plate_2', 'province_2', 'motorcycle_photo_input_2', 'plate_photo_input_2']);

      function setSecondVehicleEnabled(enabled) {
        if (!toggle || !section) return;
        section.classList.toggle('active', enabled);
        section.setAttribute('aria-hidden', enabled ? 'false' : 'true');
        secondFields.forEach(function(field) {
          field.disabled = !enabled;
          field.required = enabled && requiredIds.has(field.id);
          if (!enabled) {
            if (field.type === 'file') {
              field.value = '';
              const zone = document.querySelector('[data-file-target="' + field.id + '"]');
              if (zone) zone.classList.remove('has-file');
            } else {
              field.value = '';
            }
          }
        });
        if (!enabled) {
          ['moto-preview-2', 'plate-preview-2'].forEach(function(previewId) {
            const preview = document.getElementById(previewId);
            if (!preview) return;
            if (preview.dataset.objectUrl) {
              URL.revokeObjectURL(preview.dataset.objectUrl);
              delete preview.dataset.objectUrl;
            }
            preview.removeAttribute('src');
            preview.classList.add('hidden');
            preview.style.display = 'none';
          });
        }
      }

      if (toggle) {
        toggle.addEventListener('change', function() {
          setSecondVehicleEnabled(toggle.checked);
        });
        setSecondVehicleEnabled(toggle.checked);
      }
    })();

    (function() {
      const languageToggle = document.getElementById('language-toggle');
      if (!languageToggle) return;
      languageToggle.checked = false;
      applyLanguage('th');
      languageToggle.addEventListener('change', function() {
        applyLanguage(languageToggle.checked ? 'en' : 'th');
      });
    })();

    // ─── PDPA: sync ปุ่ม submit ทุกครั้งที่ checkbox เปลี่ยน และ sync ตอน load ───
    (function() {
      const pdpa = document.getElementById('pdpa_consent');
      if (!pdpa) return;
      pdpa.addEventListener('change', toggleSubmitBtn);
      // sync ตอน page load (รองรับ browser autofill / re-render หลัง error)
      toggleSubmitBtn();
    })();


    document.querySelectorAll('.upload-zone[data-file-target]').forEach(function(zone) {
      const input = document.getElementById(zone.dataset.fileTarget);
      const openPicker = function() {
        if (input && !input.disabled) input.click();
      };

      if (input) {
        input.addEventListener('click', function(e) {
          e.stopPropagation();
        });

        input.addEventListener('change', function() {
          var previewId = '';
          if (input.id === 'student_card_input') previewId = 'student-card-preview';
          if (input.id === 'staff_card_input') previewId = 'staff-card-preview';
          if (input.id === 'motorcycle_photo_input') previewId = 'moto-preview';
          if (input.id === 'plate_photo_input') previewId = 'plate-preview';
          if (input.id === 'motorcycle_photo_input_2') previewId = 'moto-preview-2';
          if (input.id === 'plate_photo_input_2') previewId = 'plate-preview-2';
          if (previewId) previewImage(input, previewId, zone.id);
        });
      }

      zone.addEventListener('click', function(e) {
        if (e.target === input) return;
        openPicker();
      });
      zone.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openPicker();
        }
      });
    });

    // Image preview
    function previewImage(input, previewId, zoneId) {
      const preview = document.getElementById(previewId);
      const zone = document.getElementById(zoneId);
      if (input.files && input.files[0]) {
        if (preview.dataset.objectUrl) {
          URL.revokeObjectURL(preview.dataset.objectUrl);
        }

        const objectUrl = URL.createObjectURL(input.files[0]);
        preview.dataset.objectUrl = objectUrl;
        preview.src = objectUrl;
        preview.alt = input.files[0].name;
        preview.classList.remove('hidden');
        preview.style.display = 'block';
        if (zone) zone.classList.add('has-file');
      }
    }

    // PDPA consent toggle
    function toggleSubmitBtn() {
      const checkbox = document.getElementById('pdpa_consent');
      const btn = document.getElementById('submit-btn');
      btn.disabled = !checkbox.checked;
    }

    // ─── reCAPTCHA v3 + Form Submit ─────────────────────────────────────────
    const RECAPTCHA_SITE_KEY = '<%= recaptchaSiteKey %>';

    document.getElementById('register-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const label = document.getElementById('submit-label');

      // UI: กำลังดำเนินการ
      btn.disabled = true;
      label.textContent = t('submit.checking');

      try {
        // รับ reCAPTCHA token จาก Google
        const token = await new Promise((resolve, reject) => {
          if (typeof grecaptcha === 'undefined') {
            // fallback ถ้า reCAPTCHA โหลดไม่ได้ (network issue)
            return resolve('');
          }
          grecaptcha.ready(() => {
            grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'register' })
              .then(resolve)
              .catch(reject);
          });
        });

        // ใส่ token ลงใน hidden input
        document.getElementById('recaptcha_token').value = token;

        // Submit form จริง
        label.textContent = t('submit.sending');
        this.submit();
      } catch (err) {
        console.error('reCAPTCHA error:', err);
        document.getElementById('recaptcha_token').value = '';
        try {
          this.submit();
        } catch (submitErr) {
          // ถ้า submit ล้มเหลว ให้ re-enable ปุ่มเพื่อให้ user ลองใหม่ได้
          btn.disabled = false;
          label.textContent = t('submit.default');
          console.error('Submit error:', submitErr);
        }
      }
    });

  </script>
</body>
</html>
