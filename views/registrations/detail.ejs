              <i data-lucide="plus" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 id="add-vehicle-title" class="text-base font-bold text-slate-800">เพิ่มรถ</h3>
              <p class="text-sm text-slate-500 mt-1"><%= reg.first_name %> <%= reg.last_name %></p>
            </div>
          </div>
          <button type="button" data-add-vehicle-close class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="ปิด">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
