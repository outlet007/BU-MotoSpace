<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .glass { background: rgba(255,255,255,0.7); backdrop-filter: blur(12px); }
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    @keyframes modalSlideUp { from{transform:translateY(16px);opacity:0} to{transform:translateY(0);opacity:1} }
    .sidebar-gradient { background: linear-gradient(180deg, #0f172a 0%, #1a2332 50%, #162032 100%); }
    .tooltip { position: relative; }
    .tooltip::after { content: attr(data-tip); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); padding: 4px 8px; background: #1e293b; color: white; font-size: 12px; border-radius: 6px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
    .tooltip:hover::after { opacity: 1; }
    .modal-backdrop { background: rgba(15,23,42,0.5); backdrop-filter: blur(4px); display:none; }
    .modal-backdrop.active { display: flex; }
    .vehicle-accordion-panel { max-height:0; overflow:hidden; transition:max-height .28s ease; }
    .vehicle-accordion-chevron { transition:transform .2s ease; }
    .vehicle-card-open .vehicle-accordion-chevron { transform:rotate(180deg); }
    /* Lightbox */
    .lightbox-overlay { position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.85); backdrop-filter:blur(8px); display:none; align-items:center; justify-content:center; cursor:zoom-out; }
    .lightbox-overlay.active { display:flex; animation:lbFadeIn 0.25s ease; }
    .lightbox-overlay img { max-width:90vw; max-height:85vh; object-fit:contain; border-radius:12px; box-shadow:0 25px 60px rgba(0,0,0,0.5); animation:lbZoomIn 0.3s cubic-bezier(0.16,1,0.3,1); }
    .lightbox-caption { position:absolute; bottom:24px; left:50%; transform:translateX(-50%); color:#fff; font-size:14px; background:rgba(0,0,0,0.5); padding:6px 16px; border-radius:8px; white-space:nowrap; }
    .lightbox-close { position:absolute; top:20px; right:24px; color:#fff; background:rgba(255,255,255,0.15); border:none; width:40px; height:40px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.2s; font-size:20px; }
    .lightbox-close:hover { background:rgba(255,255,255,0.3); }
    .lightbox-nav { position:absolute; top:50%; transform:translateY(-50%); color:#fff; background:rgba(255,255,255,0.15); border:none; width:44px; height:44px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.2s; font-size:22px; }
    .lightbox-nav:hover { background:rgba(255,255,255,0.3); }
    .lightbox-nav.prev { left:20px; }
    .lightbox-nav.next { right:20px; }
    .lightbox-thumb { cursor:zoom-in; transition:transform 0.2s, box-shadow 0.2s; }
    .lightbox-thumb:hover { transform:scale(1.03); box-shadow:0 4px 20px rgba(0,0,0,0.15); }
    @keyframes lbFadeIn { from{opacity:0} to{opacity:1} }
    @keyframes lbZoomIn { from{transform:scale(0.85);opacity:0} to{transform:scale(1);opacity:1} }
    @media (min-width:1024px) {
      .registration-detail-grid { grid-template-columns:minmax(0,1fr) 24rem; }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-50">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 flex flex-col lg:ml-72">
      <%- include('../partials/topbar') %>
      <main class="flex-1 p-4 sm:p-6 fade-in">
        <%- include('../partials/flash') %>
        <% const duplicatePlateMessages = typeof duplicatePlatePopup !== 'undefined' && duplicatePlatePopup ? duplicatePlatePopup : []; %>
        <% if (duplicatePlateMessages.length > 0) { %>
        <div id="duplicatePlateModal"
             style="display:flex;position:fixed;inset:0;z-index:10000;align-items:center;justify-content:center;padding:1rem;"
             aria-modal="true" role="dialog" aria-labelledby="duplicate-plate-title">
          <div data-duplicate-plate-close style="position:absolute;inset:0;background:rgba(15,23,42,.68);backdrop-filter:blur(4px);"></div>
          <div style="position:relative;width:100%;max-width:480px;background:#fff;border-radius:16px;box-shadow:0 25px 60px rgba(15,23,42,.28);overflow:hidden;animation:modalSlideUp .25s cubic-bezier(.16,1,.3,1);">
            <div style="padding:20px 24px 14px;border-bottom:1px solid #fee2e2;">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                  </div>
                  <div>
                    <h3 id="duplicate-plate-title" class="text-base font-bold text-slate-800">พบทะเบียนรถซ้ำ</h3>
                    <p class="text-sm text-slate-500 mt-1">ไม่สามารถเพิ่มหรือแก้ไขรถด้วยทะเบียนนี้ได้</p>
                  </div>
                </div>
                <button type="button" data-duplicate-plate-close class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="ปิด">
                  <i data-lucide="x" class="w-4 h-4"></i>
                </button>
              </div>
            </div>
            <div style="padding:20px 24px;">
              <div class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700 leading-relaxed">
                <%= duplicatePlateMessages[0] %>
              </div>
            </div>
            <div style="display:flex;justify-content:flex-end;padding:0 24px 22px;">
              <button type="button" data-duplicate-plate-close class="btn btn-primary justify-center">รับทราบ</button>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Back -->
        <a href="/registrations" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-brand-600 mb-4">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> กลับไปรายการ
        </a>

        <% if (!reg.deleted_at && reg.status === 'rejected') { %>
        <!-- Status Banner -->
        <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium">
          <i data-lucide="x-circle" class="w-5 h-5 text-red-500 flex-shrink-0"></i>
          <span class="min-w-0">
            รายการนี้ <strong>ถูกปฏิเสธ</strong>
            <% if (reg.notes) { %> — "<%= reg.notes %>"<% } %>
          </span>
          <span class="ml-auto text-xs text-red-500 flex-shrink-0">โดย <%= reg.approved_by_name || '-' %></span>
        </div>
        <% } %>
        <% if (!reg.deleted_at && reg.status === 'pending') { %>
        <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-orange-50 border border-orange-200 text-orange-800 text-sm font-medium">
          <i data-lucide="clock" class="w-5 h-5 text-orange-500 flex-shrink-0"></i>
          <span class="min-w-0">รายการนี้ <strong>รอตรวจสอบ</strong> — ยังไม่ได้ดำเนินการอนุมัติหรือปฏิเสธ</span>
        </div>
        <% } %>
        <% if (!reg.deleted_at && reg.status === 'approved') { %>
        <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium">
          <i data-lucide="check-circle" class="w-5 h-5 text-green-600 flex-shrink-0"></i>
          <span class="min-w-0">รายการนี้ <strong>อนุมัติ</strong> แล้ว</span>
          <span class="ml-auto text-xs text-green-600 flex-shrink-0">โดย <%= reg.approved_by_name || '-' %></span>
        </div>
        <% } %>
        <% if (reg.deleted_at) { %>
        <div class="flex items-center gap-3 mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium">
          <i data-lucide="archive-x" class="w-5 h-5 text-red-500 flex-shrink-0"></i>
          <span class="min-w-0">
            รายการนี้ <strong>ถูกลบชั่วคราว</strong> — <span class="font-semibold">หมายเหตุ:</span> <%= reg.delete_reason || '-' %>
          </span>
          <span class="ml-auto text-xs text-red-500 flex-shrink-0">โดย <%= reg.deleted_by_name || '-' %></span>
        </div>
        <% } %>

        <div class="registration-detail-grid grid grid-cols-1 gap-6">
          <!-- Left: Info -->
          <div class="space-y-6">
            <div class="card p-6">
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 bg-brand-100 rounded-2xl flex items-center justify-center">
                    <i data-lucide="<%= reg.user_type === 'student' ? 'graduation-cap' : 'briefcase' %>" class="w-7 h-7 text-brand-600"></i>
                  </div>
                  <div>
                    <h2 class="text-xl font-bold text-slate-800"><%= reg.first_name %> <%= reg.last_name %></h2>
                    <p class="text-sm text-slate-500"><%= reg.user_type === 'student' ? 'นักศึกษา' : 'บุคลากร' %> รหัส <%= reg.id_number %></p>
                  </div>
                </div>
                <span class="badge text-sm px-3 py-1 <%= reg.deleted_at ? 'badge-danger' : reg.status === 'approved' ? 'badge-success' : reg.status === 'pending' ? 'badge-warning' : 'badge-danger' %>">
                  <%= reg.deleted_at ? 'ถูกลบชั่วคราว' : reg.status === 'approved' ? 'อนุมัติ' : reg.status === 'pending' ? 'รอตรวจสอบ' : 'ปฏิเสธ' %>
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-3 bg-slate-50 rounded-xl">
                  <p class="text-xs text-slate-400 mb-1">เบอร์โทรศัพท์</p>
                  <p class="text-sm font-medium text-slate-700"><%= reg.phone || '-' %></p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl">
                  <p class="text-xs text-slate-400 mb-1">วันที่ลงทะเบียน</p>
                  <p class="text-sm font-medium text-slate-700"><%= new Date(reg.registered_at).toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'}) %></p>
                </div>
              </div>

              <div style="margin-top:10px;">
                <h3 class="text-sm font-semibold text-slate-800 mb-4 flex items-center gap-2">
                  <i data-lucide="id-card" class="w-4 h-4 text-brand-500"></i>
                  เอกสารผู้ใช้
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <% if (reg.id_card_photo) { %>
                  <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <p class="text-xs font-semibold text-slate-500 mb-2 flex items-center gap-1">
                      <i data-lucide="id-card" class="w-3.5 h-3.5"></i> รูปบัตรประจำตัว
                    </p>
                    <img src="<%= signedUrl(reg.id_card_photo) %>"
                         alt="ID Card"
                         class="w-full h-36 object-cover rounded-lg border border-slate-200 lightbox-thumb"
                         data-lightbox-src="<%= signedUrl(reg.id_card_photo) %>"
                         data-lightbox-caption="รูปบัตรประจำตัว">
                  </div>
                  <% } else { %>
                  <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 py-10 text-center text-sm text-slate-400">
                    ไม่มีเอกสารผู้ใช้
                  </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Vehicles -->
            <div id="vehicles" class="card p-6">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-sm font-semibold text-slate-800 flex items-center gap-2">
                    <i data-lucide="bike" class="w-4 h-4 text-brand-500"></i>
                    รถทั้งหมดของผู้ใช้
                  </h3>
                </div>
                <% if (!reg.deleted_at) { %>
                <button type="button" class="btn btn-primary justify-center" data-add-vehicle-open>
                  <i data-lucide="plus" class="w-4 h-4"></i> เพิ่มรถ
                </button>
                <% } %>
              </div>

              <% if (typeof vehicles !== 'undefined' && vehicles.length > 0) { %>
                <div class="space-y-4">
                  <% vehicles.forEach(function(vehicle, idx) { %>
                  <% const vehicleStatusLabel = vehicle.deleted_at ? 'ถูกลบชั่วคราว' : vehicle.status === 'approved' ? 'อนุมัติ' : vehicle.status === 'pending' ? 'รอตรวจสอบ' : 'ปฏิเสธ'; %>
                  <% const vehicleStatusClass = vehicle.deleted_at ? 'badge-danger' : vehicle.status === 'approved' ? 'badge-success' : vehicle.status === 'pending' ? 'badge-warning' : 'badge-danger'; %>
                  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden <%= vehicle.deleted_at ? 'opacity-70' : '' %>" data-vehicle-accordion>
                    <button type="button"
                            class="w-full text-left p-4 hover:bg-slate-50 transition-colors"
                            data-vehicle-toggle
                            aria-expanded="false"
                            aria-controls="vehicle-panel-<%= vehicle.id %>">
                      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                        <div class="min-w-0 flex-1">
                          <div class="flex items-start gap-3 min-w-0">
                            <span class="font-bold text-brand-700 bg-brand-50 border border-brand-100 rounded-lg flex-shrink-0" style="font-size:14px;line-height:20px;padding:4px 10px;">รถคันที่ <%= idx + 1 %></span>
                            <div class="min-w-0">
                              <p class="font-bold text-slate-800 truncate" style="font-size:14px;line-height:20px;"><%= vehicle.license_plate %></p>
                              <p class="text-slate-500 truncate" style="font-size:13px;line-height:18px;"><%= vehicle.province || '-' %></p>
                            </div>
                            <span class="badge <%= vehicleStatusClass %> flex-shrink-0" style="font-size:14px;line-height:20px;padding:2px 10px;white-space:nowrap;"><%= vehicleStatusLabel %></span>
                          </div>
                          <% if (vehicle.notes) { %>
                            <p class="text-sm text-slate-500 mt-1">หมายเหตุ: <%= vehicle.notes %></p>
                          <% } %>
                          <% if (vehicle.deleted_at) { %>
                            <p class="text-xs text-red-500 mt-1">หมายเหตุลบ: <%= vehicle.delete_reason || '-' %> · โดย <%= vehicle.deleted_by_name || '-' %></p>
                          <% } %>
                        </div>
                        <div class="flex items-center gap-2 text-xs font-semibold text-brand-600 flex-shrink-0">
                          ดูรายละเอียด
                          <i data-lucide="chevron-down" class="w-4 h-4 vehicle-accordion-chevron"></i>
                        </div>
                      </div>
                    </button>

                    <div id="vehicle-panel-<%= vehicle.id %>" class="vehicle-accordion-panel border-t border-slate-100" data-vehicle-panel>
                      <div class="p-4 space-y-4">
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                          <p class="font-bold text-slate-700 mb-3" style="font-size:14px;line-height:20px;">ข้อมูลรถคันนี้</p>
                          <% if (!vehicle.deleted_at) { %>
                            <form id="vehicle-edit-<%= vehicle.id %>" method="POST" action="/registrations/<%= reg.id %>/vehicles/<%= vehicle.id %>/edit" enctype="multipart/form-data"></form>
                            <input form="vehicle-edit-<%= vehicle.id %>" type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div>
                              <label class="label">ป้ายทะเบียน</label>
                              <input form="vehicle-edit-<%= vehicle.id %>" type="text" name="license_plate" value="<%= vehicle.license_plate %>" class="input" <%= vehicle.deleted_at ? 'disabled' : '' %> required>
                            </div>
                            <div>
                              <label class="label">จังหวัด</label>
                              <input form="vehicle-edit-<%= vehicle.id %>" type="text" name="province" value="<%= vehicle.province %>" class="input" <%= vehicle.deleted_at ? 'disabled' : '' %> required>
                            </div>
                            <div>
                              <label class="label">สถานะรถ</label>
                              <select form="vehicle-edit-<%= vehicle.id %>" name="status" class="input" <%= vehicle.deleted_at ? 'disabled' : '' %>>
                                <option value="pending" <%= vehicle.status === 'pending' ? 'selected' : '' %>>รอตรวจสอบ</option>
                                <option value="approved" <%= vehicle.status === 'approved' ? 'selected' : '' %>>อนุมัติ</option>
                                <option value="rejected" <%= vehicle.status === 'rejected' ? 'selected' : '' %>>ปฏิเสธ</option>
                              </select>
                            </div>
                            <div>
                              <label class="label">ผู้ดำเนินการ</label>
                              <div class="input bg-white text-slate-500"><%= vehicle.approved_by_name || '-' %></div>
                            </div>
                            <div class="md:col-span-2">
                              <label class="label">หมายเหตุ</label>
                              <input form="vehicle-edit-<%= vehicle.id %>" type="text" name="notes" value="<%= vehicle.notes || '' %>" class="input" <%= vehicle.deleted_at ? 'disabled' : '' %> placeholder="หมายเหตุของรถคันนี้">
                            </div>
                          </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-xs font-semibold text-slate-500 mb-2 flex items-center gap-1">
                              <i data-lucide="bike" class="w-3.5 h-3.5"></i> รูปรถคันนี้
                            </p>
                            <% if (vehicle.motorcycle_photo) { %>
                              <img src="<%= signedUrl(vehicle.motorcycle_photo) %>"
                                   alt="Motorcycle <%= vehicle.license_plate %>"
                                   class="w-full h-36 object-cover rounded-lg border border-slate-200 lightbox-thumb"
                                   data-lightbox-src="<%= signedUrl(vehicle.motorcycle_photo) %>"
                                   data-lightbox-caption="รูปรถทะเบียน <%= vehicle.license_plate %>">
                            <% } else { %>
                              <div class="h-36 rounded-lg border border-dashed border-slate-300 bg-white flex flex-col items-center justify-center text-slate-400 text-xs">
                                <i data-lucide="image-off" class="w-6 h-6 mb-1"></i>
                                ยังไม่มีรูปรถ
                              </div>
                            <% } %>
                            <% if (!vehicle.deleted_at) { %>
                              <input form="vehicle-edit-<%= vehicle.id %>"
                                     id="vehicle-motorcycle-photo-<%= vehicle.id %>"
                                     type="file"
                                     name="motorcycle_photo"
                                     accept="image/*"
                                     class="hidden"
                                     data-file-name-target="vehicle-motorcycle-photo-name-<%= vehicle.id %>">
                              <button type="button" class="btn btn-secondary btn-sm w-full justify-center mt-3" data-file-button="vehicle-motorcycle-photo-<%= vehicle.id %>">
                                <i data-lucide="image-plus" class="w-3.5 h-3.5"></i>
                                <%= vehicle.motorcycle_photo ? 'เปลี่ยนรูป' : 'เพิ่มรูป' %>
                              </button>
                              <p id="vehicle-motorcycle-photo-name-<%= vehicle.id %>" class="text-xs text-slate-400 mt-2" data-default-text="ยังไม่ได้เลือกไฟล์">ยังไม่ได้เลือกไฟล์</p>
                            <% } %>
                          </div>

                          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <p class="text-xs font-semibold text-slate-500 mb-2 flex items-center gap-1">
                              <i data-lucide="rectangle-horizontal" class="w-3.5 h-3.5"></i> รูปป้ายทะเบียนคันนี้
                            </p>
                            <% if (vehicle.plate_photo) { %>
                              <img src="<%= signedUrl(vehicle.plate_photo) %>"
                                   alt="Plate <%= vehicle.license_plate %>"
                                   class="w-full h-36 object-cover rounded-lg border border-slate-200 lightbox-thumb"
                                   data-lightbox-src="<%= signedUrl(vehicle.plate_photo) %>"
                                   data-lightbox-caption="รูปป้ายทะเบียน <%= vehicle.license_plate %>">
                            <% } else { %>
                              <div class="h-36 rounded-lg border border-dashed border-slate-300 bg-white flex flex-col items-center justify-center text-slate-400 text-xs">
                                <i data-lucide="image-off" class="w-6 h-6 mb-1"></i>
                                ยังไม่มีรูปป้ายทะเบียน
                              </div>
                            <% } %>
                            <% if (!vehicle.deleted_at) { %>
                              <input form="vehicle-edit-<%= vehicle.id %>"
                                     id="vehicle-plate-photo-<%= vehicle.id %>"
                                     type="file"
                                     name="plate_photo"
                                     accept="image/*"
                                     class="hidden"
                                     data-file-name-target="vehicle-plate-photo-name-<%= vehicle.id %>">
                              <button type="button" class="btn btn-secondary btn-sm w-full justify-center mt-3" data-file-button="vehicle-plate-photo-<%= vehicle.id %>">
                                <i data-lucide="image-plus" class="w-3.5 h-3.5"></i>
                                <%= vehicle.plate_photo ? 'เปลี่ยนรูป' : 'เพิ่มรูป' %>
                              </button>
                              <p id="vehicle-plate-photo-name-<%= vehicle.id %>" class="text-xs text-slate-400 mt-2" data-default-text="ยังไม่ได้เลือกไฟล์">ยังไม่ได้เลือกไฟล์</p>
                            <% } %>
                          </div>
                        </div>

                        <% if (!vehicle.deleted_at) { %>
                        <div class="flex flex-wrap gap-2 justify-end pt-4 border-t border-slate-100" data-no-nav>
                          <button form="vehicle-edit-<%= vehicle.id %>" type="submit" class="btn btn-secondary btn-sm">
                            <i data-lucide="save" class="w-3.5 h-3.5"></i> บันทึก
                          </button>
                          <% if (vehicle.status !== 'approved') { %>
                          <form method="POST" action="/registrations/<%= reg.id %>/vehicles/<%= vehicle.id %>/approve">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-primary btn-sm">
                              <i data-lucide="check" class="w-3.5 h-3.5"></i> อนุมัติ
                            </button>
                          </form>
                          <% } %>
                          <% if (vehicle.status !== 'rejected') { %>
                          <button type="button"
                                  class="btn btn-secondary btn-sm text-red-500 hover:bg-red-50"
                                  data-vehicle-reject-open
                                  data-reject-action="/registrations/<%= reg.id %>/vehicles/<%= vehicle.id %>/reject"
                                  data-vehicle-label="รถทะเบียน <%= vehicle.license_plate %>"
                                  data-vehicle-notes="<%= vehicle.notes || '' %>">
                            <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> ปฏิเสธ
                          </button>
                          <% } %>
