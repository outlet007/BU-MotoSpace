  <!-- Lightbox Modal -->
  <div id="lightboxOverlay" class="lightbox-overlay">
    <button type="button" class="lightbox-close" title="ปิด">✕</button>
    <button type="button" class="lightbox-nav prev" title="ก่อนหน้า">❮</button>
    <img id="lightboxImg" src="" alt="">
    <button type="button" class="lightbox-nav next" title="ถัดไป">❯</button>
    <div id="lightboxCaption" class="lightbox-caption"></div>
  </div>

  <script>lucide.createIcons();</script>
  <script>
    (function() {
      var modal = document.getElementById('duplicatePlateModal');
      if (!modal) return;
      function closeModal() {
        modal.style.display = 'none';
      }
      document.querySelectorAll('[data-duplicate-plate-close]').forEach(function(button) {
        button.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
      });
    })();

    document.addEventListener('click', function(e) {
      var row = e.target.closest('tr[data-href]');
      if (!row) return;
      if (e.target.closest('button, a, input, select, textarea, form, [data-no-nav]')) return;
      window.location.href = row.dataset.href;
    });

    (function() {
      document.querySelectorAll('[data-file-button]').forEach(function(button) {
        button.addEventListener('click', function() {
          var input = document.getElementById(button.dataset.fileButton);
          if (input) input.click();
        });
      });

      document.querySelectorAll('input[type="file"][data-file-name-target]').forEach(function(input) {
        input.addEventListener('change', function() {
          var fileName = document.getElementById(input.dataset.fileNameTarget);
          var file = input.files && input.files[0];
          if (fileName) fileName.textContent = file ? file.name : (fileName.dataset.defaultText || 'ยังไม่ได้เลือกไฟล์');
          var panel = input.closest('[data-vehicle-panel]');
          if (panel && panel.style.maxHeight && panel.style.maxHeight !== '0px') {
            panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      });
    })();

    (function() {
      var modal = document.getElementById('addVehicleModal');
      if (!modal) return;
      var form = document.getElementById('addVehicleForm');
      var firstInput = document.getElementById('add-vehicle-license-plate');

      function openModal() {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        window.setTimeout(function() {
          if (firstInput) firstInput.focus();
        }, 50);
      }

      function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        if (form) {
          form.reset();
          form.querySelectorAll('[data-default-text]').forEach(function(label) {
            label.textContent = label.dataset.defaultText || 'ยังไม่ได้เลือกไฟล์';
          });
        }
      }

      document.querySelectorAll('[data-add-vehicle-open]').forEach(function(button) {
        button.addEventListener('click', openModal);
      });

      document.querySelectorAll('[data-add-vehicle-close]').forEach(function(button) {
        button.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
      });
    })();

    (function() {
      var vehicleCards = Array.prototype.slice.call(document.querySelectorAll('[data-vehicle-accordion]'));
      if (!vehicleCards.length) return;

      function setVehicleOpen(card, isOpen) {
        var panel = card.querySelector('[data-vehicle-panel]');
        var toggle = card.querySelector('[data-vehicle-toggle]');
        if (!panel || !toggle) return;

        card.classList.toggle('vehicle-card-open', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        panel.style.maxHeight = isOpen ? panel.scrollHeight + 'px' : '0px';
      }

      vehicleCards.forEach(function(card) {
        var toggle = card.querySelector('[data-vehicle-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', function() {
          var shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
          vehicleCards.forEach(function(otherCard) {
            if (otherCard !== card) setVehicleOpen(otherCard, false);
          });
          setVehicleOpen(card, shouldOpen);
        });
      });

      window.addEventListener('resize', function() {
        vehicleCards.forEach(function(card) {
          var toggle = card.querySelector('[data-vehicle-toggle]');
          if (toggle && toggle.getAttribute('aria-expanded') === 'true') {
            setVehicleOpen(card, true);
          }
        });
      });
    })();

    (function() {
      var modal = document.getElementById('vehicleRejectModal');
      if (!modal) return;
      var form = document.getElementById('vehicleRejectForm');
      var label = document.getElementById('vehicle-reject-label');
      var notes = document.getElementById('vehicle-reject-notes');

      function openModal(button) {
        if (!form) return;
        form.action = button.dataset.rejectAction || '';
        if (label) label.textContent = button.dataset.vehicleLabel || 'รถคันนี้';
        if (notes) notes.value = button.dataset.vehicleNotes || '';
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        window.setTimeout(function() {
          if (notes) notes.focus();
        }, 50);
      }

      function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        if (form) form.action = '';
        if (notes) notes.value = '';
      }

      document.querySelectorAll('[data-vehicle-reject-open]').forEach(function(button) {
        button.addEventListener('click', function() {
          openModal(button);
        });
      });

      document.querySelectorAll('[data-vehicle-reject-close]').forEach(function(button) {
        button.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
      });
    })();

    (function() {
      var modal = document.getElementById('summonsDetailModal');
      var scheduledEl = document.getElementById('summons-detail-scheduled-at');
      var noteEl = document.getElementById('summons-detail-note');
      var byEl = document.getElementById('summons-detail-by');
      var createdAtEl = document.getElementById('summons-detail-created-at');
      var documentLink = document.getElementById('summons-detail-document');
      var editModal = document.getElementById('summonsEditModal');
      var editForm = document.getElementById('summonsEditForm');
      var editScheduledInput = document.getElementById('summons-edit-scheduled-at');
      var editNoteInput = document.getElementById('summons-edit-note');
      var editDocumentInput = document.getElementById('summons-edit-written-document');
      var editDocumentButton = document.getElementById('summons-edit-written-document-button');
      var editDocumentName = document.getElementById('summons-edit-written-document-name');
      var editExistingDocument = document.getElementById('summons-edit-existing-document');
      var editExistingDocumentLink = document.getElementById('summons-edit-existing-document-link');

      function openDetail(button) {
        if (!modal) return;
        if (scheduledEl) scheduledEl.textContent = button.dataset.scheduledAt || '-';
        if (noteEl) noteEl.textContent = decodeURIComponent(button.dataset.note || '-');
        if (byEl) byEl.textContent = button.dataset.summonedBy || '-';
        if (createdAtEl) createdAtEl.textContent = button.dataset.createdAt || '-';
        if (documentLink) {
          var documentUrl = button.dataset.documentUrl || '';
          var documentName = button.dataset.documentName || 'เอกสารแนบ';
          if (documentUrl) {
            documentLink.href = documentUrl;
            documentLink.textContent = documentName;
            documentLink.setAttribute('download', documentName);
          } else {
            documentLink.removeAttribute('href');
            documentLink.removeAttribute('download');
            documentLink.textContent = '-';
          }
        }
        modal.style.display = 'flex';
      }

      function closeDetail() {
        if (modal) modal.style.display = 'none';
      }

      function resetEditDocumentInput() {
        if (editDocumentInput) editDocumentInput.value = '';
        if (editDocumentName) editDocumentName.textContent = 'ยังไม่ได้เลือกไฟล์ใหม่';
        if (editExistingDocument) editExistingDocument.style.display = 'none';
        if (editExistingDocumentLink) {
          editExistingDocumentLink.removeAttribute('href');
          editExistingDocumentLink.removeAttribute('download');
          editExistingDocumentLink.textContent = 'เอกสารแนบ';
        }
      }

      function showExistingEditDocument(url, name) {
        if (!editExistingDocument || !editExistingDocumentLink || !url) return;
        editExistingDocumentLink.href = url;
        editExistingDocumentLink.textContent = name || 'เอกสารแนบ';
        editExistingDocumentLink.setAttribute('download', name || 'written-document');
        editExistingDocument.style.display = 'block';
      }

      function openEdit(button) {
        if (!editModal || !editForm) return;
        var row = button && button.closest ? button.closest('[data-summons-detail-row]') : null;
        var appointmentId = button.dataset.appointmentId || (row && row.dataset.appointmentId) || '';
        if (!appointmentId) return;

        editForm.action = '/registrations/<%= reg.id %>/summons/' + appointmentId + '/edit';
        if (editScheduledInput) editScheduledInput.value = button.dataset.scheduledAtInput || (row && row.dataset.scheduledAtInput) || '';
        if (editNoteInput) editNoteInput.value = decodeURIComponent(button.dataset.note || '');
        resetEditDocumentInput();
        showExistingEditDocument(button.dataset.documentUrl || (row && row.dataset.documentUrl) || '', button.dataset.documentName || (row && row.dataset.documentName) || '');
        editModal.style.display = 'flex';
        if (editScheduledInput) editScheduledInput.focus();
      }

      function closeEdit() {
        if (editModal) editModal.style.display = 'none';
      }

      if (editDocumentButton && editDocumentInput) {
        editDocumentButton.addEventListener('click', function() {
          editDocumentInput.click();
        });
      }

      if (editDocumentInput && editDocumentName) {
        editDocumentInput.addEventListener('change', function() {
          var file = editDocumentInput.files && editDocumentInput.files[0];
          editDocumentName.textContent = file ? file.name : 'ยังไม่ได้เลือกไฟล์ใหม่';
        });
      }

      document.querySelectorAll('[data-summons-detail-open]').forEach(function(button) {
        button.addEventListener('click', function() {
          openDetail(button);
        });
      });

      document.querySelectorAll('[data-summons-detail-row]').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('button, a, input, select, textarea, form, [data-no-nav]')) return;
          openDetail(row);
        });
      });

      document.querySelectorAll('[data-summons-detail-close]').forEach(function(button) {
        button.addEventListener('click', closeDetail);
      });

      document.querySelectorAll('[data-summons-edit]').forEach(function(button) {
        button.addEventListener('click', function() {
          openEdit(button);
        });
      });

      document.querySelectorAll('[data-summons-edit-close]').forEach(function(button) {
        button.addEventListener('click', closeEdit);
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && editModal && editModal.style.display === 'flex') {
          closeEdit();
          return;
        }
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
          closeDetail();
        }
      });
    })();

    // Lightbox functionality
    (function() {
      var images = [];
      var currentIndex = 0;
      var overlay = document.getElementById('lightboxOverlay');
      var closeButton = overlay.querySelector('.lightbox-close');
      var prevButton = overlay.querySelector('.lightbox-nav.prev');
      var nextButton = overlay.querySelector('.lightbox-nav.next');

      // Collect available images
      document.querySelectorAll('.lightbox-thumb').forEach(function(img, index) {
        images.push({ src: img.dataset.lightboxSrc || img.src, caption: img.dataset.lightboxCaption || img.alt || '' });
        img.addEventListener('click', function() {
          openLightbox(index);
        });
      });

      window.openLightbox = function(index) {
        if (images.length === 0) return;
        currentIndex = Math.max(0, Math.min(index || 0, images.length - 1));
        showImage();
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      };

      window.closeLightbox = function() {
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      };

      window.navigateLightbox = function(direction) {
        if (images.length === 0) return;
        currentIndex = (currentIndex + direction + images.length) % images.length;
        showImage();
      };

      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) closeLightbox();
      });

      closeButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeLightbox();
      });

      prevButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        navigateLightbox(-1);
      });

      nextButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        navigateLightbox(1);
      });

      function showImage() {
        if (images.length === 0) return;
        document.getElementById('lightboxImg').src = images[currentIndex].src;
        document.getElementById('lightboxCaption').textContent = images[currentIndex].caption + ' (' + (currentIndex + 1) + '/' + images.length + ')';
        // Hide nav buttons if only one image
        var navButtons = document.querySelectorAll('.lightbox-nav');
        navButtons.forEach(function(btn) { btn.style.display = images.length > 1 ? 'flex' : 'none'; });
      }

      // Keyboard navigation
      document.addEventListener('keydown', function(e) {
        if (!overlay.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navigateLightbox(-1);
        if (e.key === 'ArrowRight') navigateLightbox(1);
      });
    })();
  </script>

  <!-- Reject Modal -->
  <% if (!isDeleted && reg.status === 'pending') { %>
  <div id="reject-modal" style="display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;padding:1rem;" aria-modal="true" role="dialog">
    <div id="reject-modal-backdrop" style="position:absolute;inset:0;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);"></div>
    <div style="position:relative;width:100%;max-width:480px;background:#fff;border-radius:16px;box-shadow:0 25px 60px rgba(15,23,42,.28);overflow:hidden;animation:modalSlideUp .25s cubic-bezier(.16,1,.3,1);">
      <div style="padding:20px 24px 14px;border-bottom:1px solid #f1f5f9;">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x-circle" aria-hidden="true" class="lucide lucide-x-circle w-4 h-4 text-red-500"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
            <div>
              <h3 class="text-base font-bold text-slate-800">ปฏิเสธการลงทะเบียน</h3>
              <p class="text-sm text-slate-500"><%= reg.first_name %> <%= reg.last_name %></p>
            </div>
          </div>
          <button type="button" id="close-reject-modal" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="ปิด">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
      <form id="registration-reject-form" method="POST" action="/registrations/<%= reg.id %>/reject" class="p-6 space-y-4" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="label">สาเหตุของการปฏิเสธ <span class="text-red-500">*</span></label>
          <textarea id="registration-reject-notes" name="notes" class="input h-28 resize-none" required placeholder="ระบุสาเหตุของการปฏิเสธ เช่น เอกสารไม่ครบ, ข้อมูลไม่ถูกต้อง..."></textarea>
          <p id="registration-reject-notes-error" style="display:none; font-size:14px; color:#dc2626; margin:6px 0 0;">
            กรุณากรอกหมายเหตุก่อนยืนยัน
          </p>
        </div>
        <div class="flex gap-3 justify-end pt-2">
          <button type="button" id="cancel-reject-modal" class="btn btn-secondary">ยกเลิก</button>
          <button type="submit" class="btn" style="background:#dc2626;color:#fff;">
            <i data-lucide="x-circle" class="lucide lucide-x-circle w-4 h-4"></i> ยืนยันปฏิเสธ
          </button>
        </div>
      </form>
    </div>
  </div>
  <script>
    (function() {
      var modal = document.getElementById('reject-modal');
      if (!modal) return;
      var openBtn = document.getElementById('open-reject-modal');
      var closeBtn = document.getElementById('close-reject-modal');
      var cancelBtn = document.getElementById('cancel-reject-modal');
      var backdrop = document.getElementById('reject-modal-backdrop');
      var registrationRejectForm = document.getElementById('registration-reject-form');
      var registrationRejectNotes = document.getElementById('registration-reject-notes');
      var registrationRejectNotesError = document.getElementById('registration-reject-notes-error');

      function hideRegistrationRejectNotesError() {
        if (registrationRejectNotesError) registrationRejectNotesError.style.display = 'none';
      }

      function openModal() {
        hideRegistrationRejectNotesError();
        modal.style.display = 'flex';
      }

      function closeModal() {
        hideRegistrationRejectNotesError();
        modal.style.display = 'none';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);
      if (registrationRejectForm && registrationRejectNotes && registrationRejectNotesError) {
        registrationRejectForm.addEventListener('submit', function(e) {
          if (!registrationRejectNotes.value.trim()) {
            e.preventDefault();
            registrationRejectNotesError.style.display = 'block';
            registrationRejectNotes.focus();
          }
        });

        registrationRejectNotes.addEventListener('input', function() {
          registrationRejectNotesError.style.display = 'none';
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
      });
    })();
  </script>
  <% } %>
</body>
</html>
